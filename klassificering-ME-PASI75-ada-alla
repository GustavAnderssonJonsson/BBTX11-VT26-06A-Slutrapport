if (!require("pacman")) install.packages("pacman")
pacman::p_load(randomForest, caret, tidyverse, pheatmap, pROC)


log_file <- "all_results_log.csv"
if (!file.exists(log_file)) {
  write.table(data.frame(Drug=character(), Tissue=character(), Target=character(), 
                         Model=character(), AUC=numeric()), 
              log_file, sep = ",", row.names = FALSE)
}


tissues <- c("lesional", "nonlesional", "blood")
target_drug <- "Adalimumab" 
target <- "PASI75"
threshold <- 0.75
n_iterations <- 100  
train_prop <- 0.8    

for (tissue in tissues) {
  if (!dir.exists(tissue)) next
  
  # Data från sample info samr modul-egengener från WGCNA 
  samples_orig <- readRDS(file.path(tissue, "sample_info.rds"))
  genes_orig   <- readRDS(file.path(tissue, "module_eigengenes.rds"))
  
  # 2. Beräknar PASI-utfall 
  pasi_calc <- samples_orig %>%
    filter(drug == target_drug) %>%
    select(patient, week, PASI) %>%
    spread(key = week, value = PASI, sep = "_")
  
  col_b <- "week_0"; col_f <- "week_12"
  if (!(col_b %in% colnames(pasi_calc) & col_f %in% colnames(pasi_calc))) next
  
  pasi_calc <- pasi_calc %>%
    mutate(improvement = (!!sym(col_b) - !!sym(col_f)) / !!sym(col_b),
           Outcome_Var = ifelse(improvement >= threshold, "Yes", "No")) %>%
    filter(!is.na(Outcome_Var))
  
  baseline_samples <- samples_orig %>% filter(week == 0, drug == target_drug)
  final_patients <- intersect(pasi_calc$patient, baseline_samples$patient)
  
  if (length(final_patients) < 10) next
  
  samples_final <- pasi_calc %>% filter(patient %in% final_patients) %>% arrange(patient)
  gene_ids <- baseline_samples %>% filter(patient %in% final_patients) %>% arrange(patient) %>% pull(sample_id)
  genes_final <- genes_orig[gene_ids, ]
  
  df_model <- data.frame(Outcome = as.factor(samples_final$Outcome_Var), genes_final)
  
  df_model <- data.frame(Outcome = as.factor(samples_final$Outcome_Var), genes_final)
  
  # Beräkning av klassfördelning och baseline acc. 
  counts <- table(df_model$Outcome)
  n_yes <- counts["Yes"]
  n_no  <- counts["No"]
  n_total <- sum(counts)
  
  
  baseline_acc <- max(counts) / n_total
  

  message("STATISTIK FÖR ", toupper(tissue_label), ":")
  message("  Fördelning (Yes/No): ", n_yes, " / ", n_no)
  message("  Baseline Accuracy: ", round(baseline_acc * 100, 1), "%")
  # ------------------------------------------------------
  
  
  # Skapar resultatmapp 
  tissue_label <- str_to_title(tissue)
  if(tissue == "nonlesional") tissue_label <- "Non-lesional"
  
  base_dir <- paste0("CV100_FULL_", target_drug, "_", tissue, "_", target)
  dir.create(base_dir, showWarnings = FALSE)
  
  message("\n--- ANALYSERAR ", toupper(tissue_label), " (80/20 Split) ---")
  
  all_auc <- numeric(n_iterations)
  cm_list <- list()
  
  # Korsvalidering - 100 splits 
  i_iter <- 1
  while (i_iter <= n_iterations) {
    set.seed(i_iter + 4000)
    
    idx <- createDataPartition(df_model$Outcome, p = train_prop, list = FALSE)
    train_data <- df_model[idx, ]
    test_data  <- df_model[-idx, ]
    
    
    if (length(unique(test_data$Outcome)) < 2) { next }
    
    rf_full <- randomForest(Outcome ~ ., data = train_data, importance = TRUE)
    
    probs <- predict(rf_full, test_data, type = "prob")
    roc_obj <- roc(test_data$Outcome, probs[, "Yes"], quiet = TRUE)
    all_auc[i_iter] <- as.numeric(auc(roc_obj))
    
    preds <- predict(rf_full, test_data)
    cm_list[[i_iter]] <- as.matrix(table(Prediction = preds, Reference = test_data$Outcome))
    
    i_iter <- i_iter + 1
  }
  
  # Resultaten för specifik körning
  temp_results <- data.frame(
    Drug = target_drug,
    Tissue = tissue,
    Target = target,
    Model = "Full", # Eller "Top10"/"Top5" beroende på loop
    AUC = all_auc
  )
  
 
  write.table(temp_results, log_file, sep = ",", append = TRUE, 
              col.names = FALSE, row.names = FALSE)
  
  # Beräkning av medel AUC samt standardavvikelse
  mean_auc <- mean(all_auc)
  sd_auc   <- sd(all_auc)
  avg_cm <- Reduce('+', cm_list) / n_iterations
  
  
  mean_acc <- (avg_cm[1,1] + avg_cm[2,2]) / sum(avg_cm)
  
  # Skapar visualisering 
  
  # 1. AUC-fördelning visualiserat i Histogram
  auc_df <- data.frame(AUC = all_auc)
  p_auc <- ggplot(auc_df, aes(x = AUC)) +
    geom_histogram(fill = "steelblue", color = "white", bins = 15) +
    geom_vline(xintercept = mean_auc, linetype = "dashed", size = 1, color = "red") +
    labs(title = paste(target_drug, "|", tissue_label),
         subtitle = paste0("Mean AUC (100 splits): ", round(mean_auc, 3)),
         x = "AUC Score", y = "Frequency") +
    theme_minimal()
  ggsave(file.path(base_dir, "1_FullModel_AUC_Distribution.png"), p_auc, width = 7, height = 5)
  
  # 2. Confusion Matrix 
  cm_plot <- as.data.frame(avg_cm) %>%
    ggplot(aes(Prediction, Reference, fill = Freq)) +
    geom_tile() + 
    geom_text(aes(label = round(Freq, 1)), size = 8, fontface = "bold") +
    scale_fill_gradient(low = "white", high = "steelblue") +
    labs(title = paste("Average CM -", tissue_label),
         subtitle = paste0("Mean AUC: ", round(mean_auc, 3), 
                           " | Mean Accuracy: ", round(mean_acc, 3), 
                           " (", round(mean_acc * 100, 1), "%)"),
         caption = paste("Drug:", target_drug)) +
    theme_minimal()
  ggsave(file.path(base_dir, "2_FullModel_Average_CM.png"), cm_plot, width = 7, height = 6)
  
  # 3. Feature Importance selection 
  imp_full <- as.data.frame(importance(rf_full))
  imp_full$Module <- rownames(imp_full)
  p_imp <- imp_full %>%
    arrange(desc(MeanDecreaseGini)) %>%
    slice(1:20) %>% 
    ggplot(aes(x = reorder(Module, MeanDecreaseGini), y = MeanDecreaseGini)) +
    geom_bar(stat = "identity", fill = "steelblue") +
    coord_flip() +
    labs(title = paste("Top 20 Important Modules -", tissue_label),
         subtitle = paste("Importance values for", target_drug),
         x = "Modules", y = "Gini Importance") +
    theme_minimal()
  ggsave(file.path(base_dir, "3_Feature_Importance_All.png"), p_imp, width = 7, height = 8)
  
  write.csv(auc_df, file.path(base_dir, "AUC_scores_full_model.csv"))
  message("Klar med ", tissue, ". Mean AUC: ", round(mean_auc, 3), " (+/- ", round(sd_auc, 3), ")")
}

message("\n*** ANALYSEN FÄRDIG ***")
