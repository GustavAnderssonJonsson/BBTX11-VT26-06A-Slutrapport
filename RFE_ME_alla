output_dir <- "rna_seq_outputs"

evaluate_rf <- function(df, feats, n_splits = 10, test_frac = 0.2,
                        num_trees = 1000, seed = 42) {
  d <- df[, c("delta_PASI", "PASI_baseline", feats), drop = FALSE]
  d <- d[complete.cases(d), ]
  if (nrow(d) < 10) return(NULL)
  d$.row_id <- seq_len(nrow(d))
  
  importance_list <- list()
  predictions_list <- list()
  
  sp <- bind_rows(lapply(seq_len(n_splits), function(s) {
    set.seed(seed + s)
    ti <- sample(nrow(d), max(1, floor(test_frac * nrow(d))))
    train <- d[-ti, ]; test <- d[ti, ]
    
    lm_fit <- lm(delta_PASI ~ PASI_baseline, data = train)
    train$residual_PASI <- as.numeric(residuals(lm_fit))
    test$residual_PASI  <- test$delta_PASI - as.numeric(predict(lm_fit, newdata = test))
    
    m <- ranger(dependent.variable.name = "residual_PASI",
                data = train[, c("residual_PASI", feats)],
                num.trees = num_trees, importance = "permutation",
                seed = seed + s)
    p <- predict(m, data = test[, c("residual_PASI", feats)])$predictions
    o <- test$residual_PASI
    
    rmse_rf   <- sqrt(mean((p - o)^2))
    rmse_null <- sqrt(mean(o^2))
    
    importance_list[[s]] <<- m$variable.importance
    predictions_list[[s]] <<- data.frame(
      row_id = test$.row_id,
      delta_PASI = test$delta_PASI,
      PASI_baseline = test$PASI_baseline,
      residual_obs = o, residual_pred = p)
    
    data.frame(split = s, rmse = rmse_rf, rmse_null = rmse_null,
               skill = 1 - rmse_rf / rmse_null)
  }))
  
  imp_mat <- do.call(cbind, importance_list)
  imp_df <- data.frame(feature = rownames(imp_mat),
                       importance = rowMeans(imp_mat, na.rm = TRUE))
  imp_df <- imp_df[order(-imp_df$importance), ]
  
  preds_per_patient <- bind_rows(predictions_list) %>%
    group_by(row_id) %>%
    summarise(delta_PASI = first(delta_PASI),
              PASI_baseline = first(PASI_baseline),
              residual_obs = first(residual_obs),
              pred_mean = mean(residual_pred),
              .groups = "drop")
  
  list(features = feats, n_features = length(feats),
       rmse_mean = mean(sp$rmse), rmse_sd = sd(sp$rmse),
       rmse_null_mean = mean(sp$rmse_null), rmse_null_sd = sd(sp$rmse_null),
       skill_mean = mean(sp$skill), skill_sd = sd(sp$skill),
       importance = imp_df,
       predictions_patient = preds_per_patient)
}

run_rfe <- function(df, feats, drop_n = 1, min_features = 2,
                    n_splits = 10, test_frac = 0.2, num_trees = 1000, seed = 42,
                    verbose = TRUE) {
  path <- list(); cur <- feats
  while (length(cur) >= min_features) {
    res <- evaluate_rf(df, cur, n_splits, test_frac, num_trees, seed)
    if (is.null(res)) break
    if (verbose) cat(sprintf("    %2d feat | RMSE %.2f | Skill %+.2f\n",
                             length(cur), res$rmse_mean, res$skill_mean))
    path[[length(path) + 1]] <- res
    cur <- setdiff(cur, tail(res$importance$feature, drop_n))
  }
  if (length(path) == 0) return(NULL)
  best_idx <- which.min(sapply(path, `[[`, "rmse_mean"))
  list(best = path[[best_idx]], path = path)
}

# ── NEW: Nested Monte Carlo CV ───────────────────────────────────────────────
# Outer loop: held-out test set, never seen during RFE/feature selection.
# Inner loop: existing run_rfe (uses inner CV on outer_train only).

nested_rf_mc <- function(df, feats, n_outer = 20, outer_test_frac = 0.25,
                         inner_n_splits = 10, inner_test_frac = 0.2,
                         num_trees = 1000, seed = 42,
                         rfe_drop_n = 1, rfe_min_features = 2,
                         verbose = TRUE) {
  
  outer_results <- list()
  
  for (s in seq_len(n_outer)) {
    set.seed(seed + s * 1000)
    n <- nrow(df)
    out_idx <- sample(n, max(2, floor(outer_test_frac * n)))
    outer_train <- df[-out_idx, ]
    outer_test  <- df[out_idx, ]
    
    if (verbose) cat(sprintf("  Outer split %d/%d (train=%d, test=%d)\n",
                             s, n_outer, nrow(outer_train), nrow(outer_test)))
    
    # RFE on outer_train (uses inner CV with own per-split residualization)
    rfe <- run_rfe(outer_train, feats,
                   drop_n = rfe_drop_n, min_features = rfe_min_features,
                   n_splits = inner_n_splits, test_frac = inner_test_frac,
                   num_trees = num_trees, seed = seed + s * 1000,
                   verbose = FALSE)
    if (is.null(rfe)) next
    
    best_feats <- rfe$best$features
    
    lm_outer <- lm(delta_PASI ~ PASI_baseline, data = outer_train)
    outer_train$residual_PASI <- as.numeric(residuals(lm_outer))
    outer_test$residual_PASI  <- outer_test$delta_PASI -
      as.numeric(predict(lm_outer, newdata = outer_test))
    m_final <- ranger(
      dependent.variable.name = "residual_PASI",
      data = outer_train[, c("residual_PASI", best_feats)],
      num.trees = num_trees, importance = "permutation",
      seed = seed + s * 1000
    )
    p_test <- predict(m_final, data = outer_test[, c("residual_PASI", best_feats)])$predictions
    o_test <- outer_test$residual_PASI
    
    rmse_rf   <- sqrt(mean((p_test - o_test)^2))
    rmse_null <- sqrt(mean(o_test^2))
    
    # Strip heavy fields from inner path before storing
    inner_path_lite <- lapply(rfe$path, function(r) {
      list(n_features = r$n_features,
           rmse_mean = r$rmse_mean, rmse_sd = r$rmse_sd,
           rmse_null_mean = r$rmse_null_mean,
           skill_mean = r$skill_mean, skill_sd = r$skill_sd)
    })
    
    outer_results[[s]] <- list(
      outer_split = s,
      n_train = nrow(outer_train), n_test = nrow(outer_test),
      best_features = best_feats,
      n_best_features = length(best_feats),
      importance_final = m_final$variable.importance,
      rmse = rmse_rf, rmse_null = rmse_null,
      skill = 1 - rmse_rf / rmse_null,
      preds = data.frame(
        delta_PASI = outer_test$delta_PASI,
        PASI_baseline = outer_test$PASI_baseline,
        residual_obs = o_test,
        residual_pred = p_test,
        delta_pred = p_test + as.numeric(predict(lm_outer, newdata = outer_test))
      ),
      inner_skill = rfe$best$skill_mean,    # optimistic (inner-CV) skill
      inner_rmse = rfe$best$rmse_mean,
      inner_path = inner_path_lite
    )
    
    if (verbose) cat(sprintf("    → honest: RMSE %.2f vs null %.2f | Skill %+.2f | %d feats\n",
                             rmse_rf, rmse_null, outer_results[[s]]$skill,
                             length(best_feats)))
  }
  
  outer_results <- Filter(Negate(is.null), outer_results)
  if (length(outer_results) == 0) return(NULL)
  
  # Aggregate across outer splits
  skills      <- sapply(outer_results, `[[`, "skill")
  rmses       <- sapply(outer_results, `[[`, "rmse")
  rmse_nulls  <- sapply(outer_results, `[[`, "rmse_null")
  feat_counts <- sapply(outer_results, `[[`, "n_best_features")
  inner_skills <- sapply(outer_results, `[[`, "inner_skill")
  
  # Feature selection frequency across outer splits
  feat_freq <- table(unlist(lapply(outer_results, `[[`, "best_features")))
  feat_freq <- sort(feat_freq, decreasing = TRUE) / length(outer_results)
  
  # Aggregate importance: mean across outer splits where feature was selected
  all_feats_seen <- unique(unlist(lapply(outer_results,
                                         function(o) names(o$importance_final))))
  imp_mat <- matrix(NA_real_, nrow = length(all_feats_seen),
                    ncol = length(outer_results),
                    dimnames = list(all_feats_seen, NULL))
  for (i in seq_along(outer_results)) {
    imp_i <- outer_results[[i]]$importance_final
    imp_mat[names(imp_i), i] <- imp_i
  }
  imp_df <- data.frame(
    feature = rownames(imp_mat),
    importance = rowMeans(imp_mat, na.rm = TRUE),
    selection_frequency = rowMeans(!is.na(imp_mat))
  )
  imp_df <- imp_df[order(-imp_df$selection_frequency, -imp_df$importance), ]
  
  
  rfe_path_df <- bind_rows(lapply(outer_results, function(o) {
    bind_rows(lapply(o$inner_path, function(r) {
      data.frame(outer_split = o$outer_split,
                 n_features = r$n_features,
                 skill = r$skill_mean,
                 rmse = r$rmse_mean)
    }))
  }))
  rfe_path_summary <- rfe_path_df %>%
    group_by(n_features) %>%
    summarise(skill_mean = mean(skill), skill_sd = sd(skill),
              rmse_mean = mean(rmse), rmse_sd = sd(rmse),
              n_paths = n(), .groups = "drop")
  
  # Per-patient predictions aggregated (a patient may appear in multiple outer test sets)
  all_preds <- bind_rows(lapply(outer_results, function(o) o$preds))
  
  # Paired test on outer splits: outer null vs outer rf
  paired_p <- tryCatch(
    suppressWarnings(wilcox.test(rmse_nulls, rmses, paired = TRUE,
                                 alternative = "greater")$p.value),
    error = function(e) NA_real_)
  
  list(
    n_outer_splits = length(outer_results),
    honest_rmse_mean      = mean(rmses),       honest_rmse_sd      = sd(rmses),
    honest_rmse_null_mean = mean(rmse_nulls),  honest_rmse_null_sd = sd(rmse_nulls),
    honest_skill_mean     = mean(skills),      honest_skill_sd     = sd(skills),
    optimistic_skill_mean = mean(inner_skills), optimistic_skill_sd = sd(inner_skills),
    median_n_features = median(feat_counts),
    feat_count_range  = range(feat_counts),
    feature_frequency = feat_freq,
    paired_p = paired_p,
    importance_aggregated = imp_df,
    rfe_path_summary = rfe_path_summary,
    rfe_path_raw = rfe_path_df,
    outer_results = outer_results,
    predictions_all = all_preds
  )
}

permutation_null <- function(df, feats, n_perm = 100,
                             n_outer = 5, outer_test_frac = 0.25,
                             fixed_n_features = NULL,
                             num_trees = 500, seed = 1,
                             verbose = TRUE) {
  
  if (is.null(fixed_n_features)) {
    fixed_n_features <- min(length(feats), 10)
  }
  fixed_n_features <- min(fixed_n_features, length(feats))
  
  null_skills <- numeric(n_perm)
  
  for (p in seq_len(n_perm)) {
    set.seed(seed + p * 7919)
    df_perm <- df
    df_perm$delta_PASI <- sample(df$delta_PASI)  # shuffle outcome
    
    perm_skills <- numeric(n_outer)
    
    for (s in seq_len(n_outer)) {
      set.seed(seed + p * 7919 + s)
      n <- nrow(df_perm)
      out_idx <- sample(n, max(2, floor(outer_test_frac * n)))
      otrain <- df_perm[-out_idx, ]
      otest  <- df_perm[out_idx, ]
      
      lm_o <- lm(delta_PASI ~ PASI_baseline, data = otrain)
      otrain$residual_PASI <- as.numeric(residuals(lm_o))
      otest$residual_PASI  <- otest$delta_PASI -
        as.numeric(predict(lm_o, newdata = otest))
      
      # Importance ranking on outer_train (single fit, no RFE)
      m_imp <- ranger(dependent.variable.name = "residual_PASI",
                      data = otrain[, c("residual_PASI", feats)],
                      num.trees = num_trees, importance = "permutation",
                      seed = seed + p * 7919 + s)
      top_feats <- names(sort(m_imp$variable.importance,
                              decreasing = TRUE))[seq_len(fixed_n_features)]
      
      # Refit with top features only
      m_final <- ranger(dependent.variable.name = "residual_PASI",
                        data = otrain[, c("residual_PASI", top_feats)],
                        num.trees = num_trees,
                        seed = seed + p * 7919 + s)
      p_test <- predict(m_final, data = otest[, c("residual_PASI", top_feats)])$predictions
      o_test <- otest$residual_PASI
      
      rmse_rf <- sqrt(mean((p_test - o_test)^2))
      rmse_null <- sqrt(mean(o_test^2))
      perm_skills[s] <- 1 - rmse_rf / rmse_null
    }
    
    null_skills[p] <- mean(perm_skills)
    
    if (verbose && p %% 20 == 0)
      cat(sprintf("    Perm %d/%d (mean null skill so far = %+.3f)\n",
                  p, n_perm, mean(null_skills[seq_len(p)])))
  }
  
  null_skills
}

build_rf_model <- function(features, sample_info,
                           baseline_week = 0, followup_week = 12,
                           n_outer = 20, outer_test_frac = 0.25,
                           inner_n_splits = 10, inner_test_frac = 0.2,
                           num_trees = 1000,
                           seed = 42,
                           rfe_drop_n = 1, rfe_min_features = 2,
                           run_permutation = TRUE,
                           n_perm = 100, perm_n_outer = 5,
                           perm_num_trees = 500) {
  set.seed(seed)
  features <- as.data.frame(features)
  
  si <- sample_info %>% mutate(
    week = as.numeric(as.character(week)),
    PASI = as.numeric(as.character(PASI)),
    drug = tolower(trimws(as.character(drug))),
    patient = trimws(as.character(patient)),
    sample_id = rownames(sample_info)
  ) %>% dplyr::select(sample_id, patient, drug, week, PASI)
  
  bsl <- si %>% filter(week == baseline_week) %>%
    group_by(patient, drug) %>% slice(1) %>% ungroup() %>%
    rename(PASI_baseline = PASI, sid_bsl = sample_id)
  fup <- si %>% filter(week == followup_week) %>%
    group_by(patient, drug) %>% slice(1) %>% ungroup() %>%
    rename(PASI_followup = PASI)
  
  delta <- inner_join(bsl, fup, by = c("patient", "drug")) %>%
    mutate(delta_PASI = PASI_baseline - PASI_followup) %>%
    filter(!is.na(delta_PASI), !is.na(PASI_baseline))
  
  arm_results <- list()
  for (drug_nm in unique(delta$drug)) {
    arm <- filter(delta, drug == drug_nm)
    if (nrow(arm) < 10) next
    
    cat(sprintf("\n═══ %s (n=%d) ═══\n", toupper(drug_nm), nrow(arm)))
    lm_fit_report <- lm(delta_PASI ~ PASI_baseline, data = arm)
    
    X <- features[arm$sid_bsl, , drop = FALSE]
    df <- bind_cols(data.frame(delta_PASI = as.numeric(arm$delta_PASI),
                               PASI_baseline = as.numeric(arm$PASI_baseline)), X)
    df <- df[complete.cases(df), ]
    if (nrow(df) < 10) next
    
    fcols <- colnames(X)
    
    cat(sprintf("  Running nested MC CV (n_outer=%d, test_frac=%.2f)...\n",
                n_outer, outer_test_frac))
    t0 <- Sys.time()
    nested <- nested_rf_mc(df, fcols,
                           n_outer = n_outer, outer_test_frac = outer_test_frac,
                           inner_n_splits = inner_n_splits,
                           inner_test_frac = inner_test_frac,
                           num_trees = num_trees, seed = seed,
                           rfe_drop_n = rfe_drop_n,
                           rfe_min_features = rfe_min_features,
                           verbose = FALSE)
    cat(sprintf("  Nested CV done in %.1f min\n",
                as.numeric(Sys.time() - t0, units = "mins")))
    
    if (is.null(nested)) next
    
    cat(sprintf("  → HONEST     skill = %+.3f ± %.3f\n",
                nested$honest_skill_mean, nested$honest_skill_sd))
    cat(sprintf("  → OPTIMISTIC skill = %+.3f ± %.3f (inner CV)\n",
                nested$optimistic_skill_mean, nested$optimistic_skill_sd))
    cat(sprintf("  → median feat count = %d (range %d–%d)\n",
                as.integer(nested$median_n_features),
                nested$feat_count_range[1], nested$feat_count_range[2]))
    
    perm <- NULL
    if (run_permutation) {
      cat(sprintf("  Running permutation null (n_perm=%d, fixed n_feats=%d)...\n",
                  n_perm, as.integer(nested$median_n_features)))
      t1 <- Sys.time()
      null_skills <- permutation_null(df, fcols,
                                      n_perm = n_perm,
                                      n_outer = perm_n_outer,
                                      outer_test_frac = outer_test_frac,
                                      fixed_n_features = nested$median_n_features,
                                      num_trees = perm_num_trees,
                                      seed = seed,
                                      verbose = TRUE)
      p_value <- mean(null_skills >= nested$honest_skill_mean)
      perm <- list(null_skills = null_skills,
                   null_mean = mean(null_skills),
                   null_sd = sd(null_skills),
                   p_value = p_value,
                   fixed_n_features = nested$median_n_features)
      cat(sprintf("  Permutation done in %.1f min\n",
                  as.numeric(Sys.time() - t1, units = "mins")))
      cat(sprintf("  → permutation p = %.3f (null skill: %+.3f ± %.3f)\n",
                  p_value, perm$null_mean, perm$null_sd))
    }
    
    arm_results[[drug_nm]] <- c(
      list(n_patients = nrow(df), baseline_lm = lm_fit_report,
           drug = drug_nm),
      nested,
      list(permutation = perm,
           # backward-compatible aliases for plotting
           features = head(nested$importance_aggregated$feature,
                           as.integer(nested$median_n_features)),
           rmse_mean      = nested$honest_rmse_mean,
           rmse_sd        = nested$honest_rmse_sd,
           rmse_null_mean = nested$honest_rmse_null_mean,
           rmse_null_sd   = nested$honest_rmse_null_sd,
           skill_mean     = nested$honest_skill_mean,
           skill_sd       = nested$honest_skill_sd,
           importance     = nested$importance_aggregated,
           predictions_patient = nested$predictions_all %>%
             dplyr::mutate(pred_mean = residual_pred)
      )
    )
  }
  arm_results
}

