print_arm_summary <- function(results, tissue) {
  cat(sprintf("\n══ %s ══\n", toupper(tissue)))
  for (nm in names(results)) {
    a <- results[[nm]]
    if (is.null(a)) next
    cat(sprintf("\n%s (n=%d, %d outer splits):\n",
                nm, a$n_patients, a$n_outer_splits))
    cat(sprintf("  HONEST     : RMSE %.2f ± %.2f vs null %.2f | Skill %+.3f ± %.3f | p_pair=%.3f\n",
                a$honest_rmse_mean, a$honest_rmse_sd,
                a$honest_rmse_null_mean,
                a$honest_skill_mean, a$honest_skill_sd, a$paired_p))
    cat(sprintf("  OPTIMISTIC : Skill %+.3f ± %.3f (inner CV)\n",
                a$optimistic_skill_mean, a$optimistic_skill_sd))
    cat(sprintf("  Median feature count: %d (range %d–%d)\n",
                as.integer(a$median_n_features),
                a$feat_count_range[1], a$feat_count_range[2]))
    if (!is.null(a$permutation)) {
      cat(sprintf("  PERMUTATION: null skill = %+.3f ± %.3f, p = %.3f\n",
                  a$permutation$null_mean, a$permutation$null_sd,
                  a$permutation$p_value))
    }
    cat("  Top 10 features (by selection frequency):\n")
    print(head(a$importance, 10))
  }
}

