# RF vs null summary (now using honest outer-test metrics)
plot_rf_vs_null_summary <- function(all_results, metric = c("rmse", "skill"),
                                    save_path = NULL) {
  metric <- match.arg(metric)
  rows <- list()
  for (tissue_nm in names(all_results)) {
    for (drug_nm in names(all_results[[tissue_nm]])) {
      a <- all_results[[tissue_nm]][[drug_nm]]
      if (is.null(a)) next
      rows[[length(rows) + 1]] <- data.frame(
        tissue = tissue_nm, drug = drug_nm,
        rmse_rf = a$honest_rmse_mean, rmse_rf_sd = a$honest_rmse_sd,
        rmse_null = a$honest_rmse_null_mean, rmse_null_sd = a$honest_rmse_null_sd,
        skill = a$honest_skill_mean, skill_sd = a$honest_skill_sd)
    }
  }
  df <- bind_rows(rows)
  df$tissue <- factor(cap(df$tissue), levels = c("Lesional", "Nonlesional", "Blood"))
  df$drug   <- factor(cap(df$drug))
  
  named_drug_colors <- setNames(drug_colors, cap(names(drug_colors)))
  
  if (metric == "rmse") {
    plot_df <- df %>%
      pivot_longer(c(rmse_rf, rmse_null), names_to = "model", values_to = "rmse") %>%
      mutate(sd = ifelse(model == "rmse_rf", rmse_rf_sd, rmse_null_sd),
             model = factor(model, levels = c("rmse_null", "rmse_rf"),
                            labels = c("Null (baseline-PASI only)", "RF (eigengenes)")))
    
    p <- ggplot(plot_df, aes(drug, rmse, fill = drug, alpha = model)) +
      geom_col(position = position_dodge(0.8), width = 0.7,
               color = "black", linewidth = 0.3) +
      geom_errorbar(aes(ymin = pmax(rmse - sd, 0), ymax = rmse + sd, group = model),
                    position = position_dodge(0.8), width = 0.25,
                    color = "grey30", alpha = 1) +
      scale_fill_manual(values = named_drug_colors) +
      scale_alpha_manual(values = c("Null (baseline-PASI only)" = 0.4,
                                    "RF (eigengenes)" = 1.0)) +
      facet_wrap(~ tissue) +
      labs(title = "RF vs Null — Honest Outer-Holdout RMSE",
           x = NULL, y = "Mean RMSE (± sd over outer splits)",
           fill = "Drug", alpha = "Model") +
      guides(fill = guide_legend(override.aes = list(alpha = 1), order = 1),
             alpha = guide_legend(override.aes = list(fill = "grey50"), order = 2))
  } else {
    p <- ggplot(df, aes(drug, skill, fill = drug)) +
      geom_col(width = 0.7, color = "black", linewidth = 0.3) +
      geom_errorbar(aes(ymin = skill - skill_sd, ymax = skill + skill_sd),
                    width = 0.25, color = "grey30") +
      geom_hline(yintercept = 0, linetype = "dashed", color = "grey40") +
      scale_fill_manual(values = named_drug_colors) +
      facet_wrap(~ tissue) +
      labs(title = "RF Skill Score — Honest Outer-Holdout",
           x = NULL, y = "Skill score (± sd over outer splits)", fill = "Drug")
  }
  p <- p + theme_bw(base_size = 12) +
    theme(plot.title = element_text(face = "bold"),
          legend.position = "top",
          axis.text.x = element_blank(),
          axis.ticks.x = element_blank(),
          strip.background = element_rect(fill = "grey95", color = NA),
          strip.text = element_text(face = "bold"))
  if (!is.null(save_path)) ggsave(save_path, p, width = 11, height = 5, dpi = 300)
  print(p); invisible(p)
}

