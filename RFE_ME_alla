drug_colors   <- c("adalimumab" = "#2E86AB", "ustekinumab" = "#E63946")
tissue_colors <- c("lesional" = "#C73E1D", "nonlesional" = "#F4A261",
                   "blood" = "#2A9D8F")

cap <- function(x) tools::toTitleCase(tolower(x))

# Importance grid: shows mean importance + selection frequency
plot_importance_grid <- function(all_results, top_n = 15, save_path = NULL) {
  rows <- list()
  for (tissue_nm in names(all_results)) {
    for (drug_nm in names(all_results[[tissue_nm]])) {
      a <- all_results[[tissue_nm]][[drug_nm]]
      if (is.null(a) || is.null(a$importance)) next
      top <- head(a$importance, top_n)
      rows[[length(rows) + 1]] <- data.frame(
        tissue = tissue_nm, drug = drug_nm,
        feature = top$feature,
        importance = top$importance,
        selection_frequency = top$selection_frequency)
    }
  }
  d <- bind_rows(rows)
  d$tissue <- factor(cap(d$tissue), levels = c("Lesional", "Nonlesional", "Blood"))
  d$drug   <- factor(cap(d$drug))
  d$panel_feature <- paste(d$tissue, d$drug, d$feature, sep = "|")
  d <- d %>% arrange(tissue, drug, importance) %>%
    mutate(panel_feature = factor(panel_feature, levels = panel_feature))
  
  named_drug_colors <- setNames(drug_colors, cap(names(drug_colors)))
  
  p <- ggplot(d, aes(importance, panel_feature,
                     fill = drug, alpha = selection_frequency)) +
    geom_col(color = "black", linewidth = 0.3) +
    facet_grid(drug ~ tissue, scales = "free_y") +
    scale_fill_manual(values = named_drug_colors, guide = "none") +
    scale_alpha_continuous(range = c(0.3, 1), limits = c(0, 1),
                           name = "Selection\nfrequency") +
    scale_y_discrete(labels = function(x) sub("^.*\\|", "", x)) +
    labs(title = "Eigengene Importance — Mean Across Outer Splits",
         subtitle = "Bar opacity reflects how often a feature was retained by RFE",
         x = "Mean permutation importance", y = NULL) +
    theme_bw(base_size = 11) +
    theme(plot.title = element_text(face = "bold"),
          strip.background = element_rect(fill = "grey95", color = NA),
          strip.text = element_text(face = "bold"),
          panel.grid.major.y = element_blank())
  
  if (!is.null(save_path)) ggsave(save_path, p, width = 12, height = 8, dpi = 300)
  print(p); invisible(p)
}

plot_pred_vs_measured_grid <- function(all_results, save_path = NULL) {
  rows <- list()
  for (tissue_nm in names(all_results)) {
    for (drug_nm in names(all_results[[tissue_nm]])) {
      a <- all_results[[tissue_nm]][[drug_nm]]
      if (is.null(a) || is.null(a$predictions_all)) next
      d <- a$predictions_all
      rows[[length(rows) + 1]] <- data.frame(
        tissue = tissue_nm, drug = drug_nm,
        obs = d$delta_PASI, pred = d$delta_pred)
    }
  }
  d <- bind_rows(rows)
  d$tissue <- factor(cap(d$tissue), levels = c("Lesional", "Nonlesional", "Blood"))
  d$drug   <- factor(cap(d$drug))
  
  named_drug_colors <- setNames(drug_colors, cap(names(drug_colors)))
  
  p <- ggplot(d, aes(obs, pred, color = drug)) +
    geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "grey40") +
    geom_point(size = 2, alpha = 0.55) +
    facet_grid(drug ~ tissue) +
    coord_equal() +
    scale_color_manual(values = named_drug_colors, guide = "none") +
    labs(title = "Predicted vs Measured ΔPASI (outer holdout only)",
         x = "Measured ΔPASI", y = "Predicted ΔPASI") +
    theme_bw(base_size = 12) +
    theme(plot.title = element_text(face = "bold"),
          strip.background = element_rect(fill = "grey95", color = NA),
          strip.text = element_text(face = "bold"))
  
  if (!is.null(save_path)) ggsave(save_path, p, width = 11, height = 7, dpi = 300)
  print(p); invisible(p)
}

plot_rfe_paths_combined <- function(all_results, save_path = NULL) {
  rows <- list()
  for (tissue_nm in names(all_results)) {
    for (drug_nm in names(all_results[[tissue_nm]])) {
      a <- all_results[[tissue_nm]][[drug_nm]]
      if (is.null(a) || is.null(a$rfe_path_summary)) next
      tmp <- a$rfe_path_summary
      tmp$tissue <- tissue_nm; tmp$drug <- drug_nm
      rows[[length(rows) + 1]] <- tmp
    }
  }
  d <- bind_rows(rows)
  d$tissue <- factor(cap(d$tissue), levels = c("Lesional", "Nonlesional", "Blood"))
  d$drug <- factor(cap(d$drug))
  
  named_tissue_colors <- setNames(tissue_colors, cap(names(tissue_colors)))
  
  p <- ggplot(d, aes(n_features, skill_mean, color = tissue, fill = tissue,
                     group = tissue)) +
    geom_hline(yintercept = 0, linetype = "dotted", color = "grey40") +
    geom_ribbon(aes(ymin = skill_mean - skill_sd, ymax = skill_mean + skill_sd),
                alpha = 0.15, color = NA) +
    geom_line(linewidth = 0.9) +
