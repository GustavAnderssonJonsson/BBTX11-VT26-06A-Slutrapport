load_tissue_data <- function(tissue, output_dir = "rna_seq_outputs") {
  MEs <- readRDS(file.path(output_dir, paste0("WGCNA_", tissue), "module_eigengenes.rds"))
  si  <- readRDS(file.path(output_dir, paste0("WGCNA_", tissue), "sample_info.rds"))
  if ("sample_id" %in% colnames(si)) rownames(si) <- si$sample_id
  grey_cols <- grep("^MEgrey$|^ME0$", colnames(MEs), value = TRUE,
                    ignore.case = TRUE)
  if (length(grey_cols) > 0) {
    MEs <- MEs[, !colnames(MEs) %in% grey_cols, drop = FALSE]
    cat(sprintf("  Dropped %d unassigned-module eigengene(s): %s\n",
                length(grey_cols), paste(grey_cols, collapse = ", ")))
  }
  
  common <- intersect(rownames(si), rownames(MEs))
  list(MEs = MEs[common, , drop = FALSE], sample_info = si[common, , drop = FALSE])
}

run_rf_for_tissue <- function(tissue, output_dir = "rna_seq_outputs", ...) {
  dat <- load_tissue_data(tissue, output_dir)
  res <- build_rf_model(dat$MEs, dat$sample_info, ...)
  print_arm_summary(res, tissue)
  saveRDS(res, file.path(output_dir, sprintf("rf_eigengene_%s_results.rds", tissue)))
  invisible(res)
}

