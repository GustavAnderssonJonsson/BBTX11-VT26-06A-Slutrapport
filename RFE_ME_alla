# NEW: permutation null distributions vs observed honest skill
plot_permutation_nulls <- function(all_results, save_path = NULL) {
  rows <- list(); obs_rows <- list()
  for (tissue_nm in names(all_results)) {
    for (drug_nm in names(all_results[[tissue_nm]])) {
      a <- all_results[[tissue_nm]][[drug_nm]]
      if (is.null(a) || is.null(a$permutation)) next
      rows[[length(rows) + 1]] <- data.frame(
        tissue = tissue_nm, drug = drug_nm,
        null_skill = a$permutation$null_skills)
      obs_rows[[length(obs_rows) + 1]] <- data.frame(
        tissue = tissue_nm, drug = drug_nm,
        obs_skill = a$honest_skill_mean,
        p_value = a$permutation$p_value)
    }
  }
  if (length(rows) == 0) {
    cat("No permutation results found.\n"); return(invisible(NULL))
  }
  d  <- bind_rows(rows)
  do <- bind_rows(obs_rows)
  d$tissue  <- factor(cap(d$tissue),  levels = c("Lesional", "Nonlesional", "Blood"))
  d$drug    <- factor(cap(d$drug))
  do$tissue <- factor(cap(do$tissue), levels = c("Lesional", "Nonlesional", "Blood"))
  do$drug   <- factor(cap(do$drug))
  
  p <- ggplot(d, aes(null_skill)) +
    geom_histogram(bins = 25, fill = "grey70", color = "grey40",
                   linewidth = 0.2) +
    geom_vline(data = do, aes(xintercept = obs_skill),
               color = "red", linewidth = 0.9) +
    geom_text(data = do,
              aes(x = obs_skill, y = Inf,
                  label = sprintf("p=%.3f", p_value)),
              vjust = 1.4, hjust = -0.1, size = 3.2, color = "red") +
    facet_grid(drug ~ tissue) +
    labs(title = "Permutation Null Distribution of Honest Skill",
         subtitle = "Red line: observed honest skill on real data",
         x = "Skill score under shuffled outcome", y = "Count") +
    theme_bw(base_size = 11) +
    theme(plot.title = element_text(face = "bold"),
          strip.background = element_rect(fill = "grey95", color = NA),
          strip.text = element_text(face = "bold"))
  
  if (!is.null(save_path)) ggsave(save_path, p, width = 11, height = 7, dpi = 300)
  print(p); invisible(p)
}

