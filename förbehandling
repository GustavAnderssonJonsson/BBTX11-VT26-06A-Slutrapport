cat("Skin_d: ", nrow(skin_d_raw), "genes x", ncol(skin_d_raw), "samples\n")
cat("Skin_r: ", nrow(skin_r_raw), "genes x", ncol(skin_r_raw), "samples\n")


#  SKAPAR ORDNING


sdrf <- read.delim("E-MTAB-14509.sdrf.txt", check.names = FALSE,
                   stringsAsFactors = FALSE)
colnames(sdrf) <- trimws(colnames(sdrf))

cols_keep <- c(
  "Source Name",
  "Characteristics[individual]",
  "Characteristics[organism]",
  "Characteristics[age]",
  "Characteristics[sex]",
  "Characteristics[organism part]",
  "Characteristics[disease]",
  "Characteristics[drug]",
  "Characteristics[psoriasis area severity index (pasi)]",
  "Characteristics[disease onset type]",
  "Characteristics[age of onset]",
  "Characteristics[biologic naive patient]",
  "Characteristics[anti tnf naive patient]",
  "Characteristics[psoriatic arthritis]",
  "Characteristics[body mass index]",
  "Characteristics[hla_c0602 carrier]",
  "Factor Value[time]"
)

cols_keep  <- cols_keep[cols_keep %in% colnames(sdrf)]
sdrf_clean <- sdrf[, cols_keep]

all_new_names <- c(
  "sample_id", "patient", "organism", "age", "sex", "tissue",
  "disease", "drug", "PASI", "onset_type", "age_of_onset",
  "biologic_naive", "anti_tnf_naive", "psoriatic_arthritis",
  "BMI", "HLA_C0602", "week"
)
colnames(sdrf_clean) <- all_new_names[seq_along(cols_keep)]

cat("\nMetadata columns found:", length(cols_keep), "out of 17\n")

# Helper function for type conversion
fix_if_exists <- function(df, col, fn, ...) {
  if (col %in% colnames(df)) df[[col]] <- fn(df[[col]], ...)
  return(df)
}

#  BLOOD DATA


#  Remove controls 
controls    <- c("PSORT-P3-UHR", "PSORT-P4-UHR")
blood_raw   <- blood_raw[, !colnames(blood_raw) %in% controls]
blood_samples <- colnames(blood_raw)

cat("Blood samples after control removal:", length(blood_samples), "\n")

#  Match to metadata 
sdrf_blood <- sdrf_clean[grepl("02$", sdrf_clean$sample_id), ]
sample_key_blood <- sub("..$", "", blood_samples)
sdrf_blood$match_key <- sub("..$", "", sdrf_blood$sample_id)

keep_blood <- blood_samples[sample_key_blood %in% sdrf_blood$match_key]
blood_raw  <- blood_raw[, keep_blood]
blood_samples <- colnames(blood_raw)
sample_key_blood <- sub("..$", "", blood_samples)

matched_idx <- match(sample_key_blood, sdrf_blood$match_key)
sample_info_blood <- sdrf_blood[matched_idx, ]
rownames(sample_info_blood) <- blood_samples

cat("Blood samples with metadata:", nrow(sample_info_blood), "\n")

#  Fix metadata types 
sample_info_blood <- fix_if_exists(sample_info_blood, "patient", factor)
sample_info_blood <- fix_if_exists(sample_info_blood, "week", function(x) factor(as.integer(x)))
sample_info_blood <- fix_if_exists(sample_info_blood, "sex", factor, levels = c(0,1), labels = c("Male","Female"))
sample_info_blood <- fix_if_exists(sample_info_blood, "drug", factor)
sample_info_blood <- fix_if_exists(sample_info_blood, "disease", factor)
sample_info_blood <- fix_if_exists(sample_info_blood, "age", as.numeric)
sample_info_blood <- fix_if_exists(sample_info_blood, "PASI", as.numeric)
sample_info_blood <- fix_if_exists(sample_info_blood, "BMI", as.numeric)

# 3d. Sample QC 
dge_blood <- DGEList(counts = as.matrix(blood_raw))
dge_blood <- calcNormFactors(dge_blood, method = "TMM")
norm_factors_blood <- dge_blood$samples$norm.factors

cat("\nBlood TMM norm factors:\n")
print(summary(norm_factors_blood))

outliers_blood <- names(norm_factors_blood[norm_factors_blood > 2.0 | norm_factors_blood < 0.5])
cat("Blood outliers removed:", length(outliers_blood), "\n")
if(length(outliers_blood) > 0) print(outliers_blood)

good_blood <- colnames(dge_blood)[!colnames(dge_blood) %in% outliers_blood]
dge_blood <- dge_blood[, good_blood]
sample_info_blood <- sample_info_blood[good_blood, ]

cat("Blood samples after QC:", ncol(dge_blood), "\n")

#  3e. Gene filtering 
keep_blood <- filterByExpr(dge_blood, min.count = 10, group = sample_info_blood$week)
dge_blood  <- dge_blood[keep_blood, , keep.lib.sizes = FALSE]

cat("Blood genes after filtering:", nrow(dge_blood), "\n")

# 3f. Final normalization and voom 
dge_blood <- calcNormFactors(dge_blood, method = "TMM")
design_blood <- model.matrix(~ 1, data = sample_info_blood)
v_blood <- voom(dge_blood, design_blood, plot = TRUE)

expr_blood   <- t(v_blood$E)  # samples x genes
cat("Blood final matrix:", nrow(expr_blood), "samples x", ncol(expr_blood), "genes\n")

# MEST VARIANTA 15000

n_genes <- 15000
form <- ~ (1|patient) + (1|week) + (1|drug)
varPart_blood <- fitExtractVarPartModel(t(expr_blood), form, sample_info_blood,
                                        BPPARAM = SnowParam(2))
treatment_var_blood  <- varPart_blood$week + varPart_blood$drug
top_genes_blood      <- names(sort(treatment_var_blood, decreasing=TRUE)[1:min(n_genes, nrow(varPart_blood))])
expr_wgcna_blood     <- expr_blood[, top_genes_blood]
cat("Blood WGCNA matrix:", ncol(expr_wgcna_blood), "genes\n")

