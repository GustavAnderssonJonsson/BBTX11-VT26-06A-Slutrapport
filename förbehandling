## UMAP VISUALISERING AV ALL TISSUE 

run_umap_plot <- function(expr_matrix, metadata, title){
  
  # Run UMAP
  umap_res <- umap(expr_matrix)
  
  umap_df <- data.frame(
    UMAP1 = umap_res$layout[,1],
    UMAP2 = umap_res$layout[,2],
    week  = metadata$week
  )
  
  # Professional plot
  p <- ggplot(umap_df, aes(UMAP1, UMAP2, color = week)) +
    geom_point(size = 2.5, alpha = 0.85) +
    
    scale_color_brewer(palette = "Dark2") +
    
    labs(
      title = paste("UMAP of", title, "RNA-seq Samples"),
      subtitle = "Samples colored by treatment week",
      x = "UMAP 1",
      y = "UMAP 2",
      color = "Week"
    ) +
    
    theme_bw(base_size = 13) +
    
    theme(
      plot.title = element_text(face = "bold", size = 15),
      plot.subtitle = element_text(size = 11),
      legend.position = "top",
      legend.title = element_text(face = "bold"),
      panel.grid = element_blank(),
      axis.text = element_text(color = "black")
    )
  
  print(p)
  return(p)
}

