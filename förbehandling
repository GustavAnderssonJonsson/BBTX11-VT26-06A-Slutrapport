output_dir <- "rna_seq_outputs"
if (!dir.exists(output_dir)) {
  dir.create(output_dir)
  cat("Created output directory:", output_dir, "\n")
}

#  HÄMTAR

blood_raw   <- read.delim("Blood_raw_counts_d.txt", check.names = FALSE)
skin_d_raw  <- read.delim("Skin_raw_counts_d.txt", check.names = FALSE)
skin_r_raw  <- read.delim("Skin_raw_counts_r.txt", check.names = FALSE)

