                           tissue_params$blood$soft_power_override,
                           tissue_params$blood$min_module_size,
                           tissue_params$blood$merge_cut_height)
rm(expr_tmp, sample_info_tmp); gc()

# CROSS-TISSUE CORRELATION
cat("\nCross-tissue eigengene correlation...\n")

get_ME_with_key <- function(results, label) {
  si <- results$sample_info
  me <- results$MEs %>% as.data.frame() %>% dplyr::select(-matches("grey"))
  me$patient_week <- paste0(si$patient, "_w", si$week)
  me$patient <- as.character(si$patient)
  me$week    <- as.character(si$week)
  return(me)
}

ME_lesional    <- get_ME_with_key(results_lesional,    "lesional")
ME_nonlesional <- get_ME_with_key(results_nonlesional, "nonlesional")
ME_blood       <- get_ME_with_key(results_blood,       "blood")

common_keys <- Reduce(intersect, list(ME_lesional$patient_week,
                                      ME_nonlesional$patient_week,
                                      ME_blood$patient_week))
cat("Matched patient-week combinations:", length(common_keys), "\n")

if (length(common_keys) >= 5) {
  
  drop_cols <- c("patient_week", "patient", "week")
  align     <- function(me, keys) me[match(keys, me$patient_week),
                                     !colnames(me) %in% drop_cols]
  
  ME_les_mat <- align(ME_lesional,    common_keys); colnames(ME_les_mat) <- paste0("Les_",    colnames(ME_les_mat))
  ME_non_mat <- align(ME_nonlesional, common_keys); colnames(ME_non_mat) <- paste0("NonLes_", colnames(ME_non_mat))
  ME_blo_mat <- align(ME_blood,       common_keys); colnames(ME_blo_mat) <- paste0("Blood_",  colnames(ME_blo_mat))
  
  cross_cor <- cor(cbind(ME_les_mat, ME_non_mat, ME_blo_mat), use = "p")
  
  les_cols <- grep("^Les_",    colnames(cross_cor))
  non_cols <- grep("^NonLes_", colnames(cross_cor))
  blo_cols <- grep("^Blood_",  colnames(cross_cor))
  
  cross_dir <- file.path(output_dir, "WGCNA_cross_tissue")
  if (!dir.exists(cross_dir)) dir.create(cross_dir)
  
  plot_cross <- function(mat, title, fname) {
    df <- as.data.frame(mat) %>%
      mutate(row_module = rownames(mat)) %>%
      pivot_longer(-row_module, names_to = "col_module", values_to = "cor")
    ggsave(file.path(cross_dir, fname),
           ggplot(df, aes(col_module, row_module, fill = cor)) +
             geom_tile(color = "white") +
             geom_text(aes(label = round(cor, 2)), size = 3) +
             scale_fill_gradient2(low = "#d73027", mid = "white", high = "#2166ac",
                                  midpoint = 0, limits = c(-1, 1)) +
             labs(title = title, x = NULL, y = NULL) +
             theme_bw(base_size = 11) +
             theme(axis.text.x = element_text(angle = 45, hjust = 1), panel.grid = element_blank()),
           width  = max(6, 0.6 * ncol(mat) + 3),
           height = max(5, 0.5 * nrow(mat) + 2), dpi = 300)
  }

  plot_cross(cross_cor[les_cols, blo_cols], "Lesional vs Blood",       "cor_lesional_vs_blood.png")
  plot_cross(cross_cor[les_cols, non_cols], "Lesional vs Nonlesional", "cor_lesional_vs_nonlesional.png")
  plot_cross(cross_cor[non_cols, blo_cols], "Nonlesional vs Blood",    "cor_nonlesional_vs_blood.png")
  
  write.csv(as.data.frame(cross_cor),
            file.path(cross_dir, "cross_tissue_ME_correlations.csv"))
  gc()
  cat("Cross-tissue plots saved.\n")
  
} else {
  cat("Too few matched samples .\n")
}

cat("\nDone. Outputs in rna_seq_outputs/WGCNA_*/\n")
