library(WGCNA)
library(ggplot2)
library(dplyr)
library(tidyr)

disableWGCNAThreads()
output_dir <- "rna_seq_outputs"

#PARAMETRAR SAMLADE HÄR
tissue_params <- list(
  lesional = list(
    r2_threshold        = 0.85,
    soft_power_override = NULL,
    min_module_size     = 25,
    merge_cut_height    = 0.25),
  nonlesional = list(
    r2_threshold        = 0.85,
    soft_power_override = NULL,
    min_module_size     = 25,
    merge_cut_height    = 0.25),
  blood = list(
    r2_threshold        = 0.85,
    soft_power_override = NULL,
    min_module_size     = 25,
    merge_cut_height    = 0.25)
)
# funktion
run_wgcna <- function(expr_wgcna, sample_info, tissue_label, wgcna_dir,
                      r2_threshold, soft_power_override,
                      min_module_size, merge_cut_height) {
  #skapar mapp
  if (!dir.exists(wgcna_dir)) dir.create(wgcna_dir, recursive = TRUE)
  
  
  cat("\nWGCNA —", tissue_label)
  cat(nrow(expr_wgcna), "samples x", ncol(expr_wgcna), "genes\n")
  
  # ser till att det inte finns konstiga N/A ellr 0 var samples
  gsg <- goodSamplesGenes(expr_wgcna, verbose = 1)
  if (!gsg$allOK) {
    expr_wgcna  <- expr_wgcna[gsg$goodSamples, gsg$goodGenes]
    sample_info <- sample_info[gsg$goodSamples, ]
  }
  gc()

  # Sample tree
  png(file.path(wgcna_dir, "01_sample_clustering.png"))
  plot(hclust(dist(expr_wgcna), method = "average"),
       main = paste(tissue_label, "— sample clustering"), sub = "", xlab = "", labels = FALSE)
  dev.off()
  gc()
  
  # THRESHOLD
  powers  <- c(1:10, seq(12, 20, 2))
  sft     <- pickSoftThreshold(expr_wgcna, powerVector = powers,
                               networkType = "signed", verbose = 1, blockSize = 5400)
  r2_vals <- -sign(sft$fitIndices[, 3]) * sft$fitIndices[, 2]
  
  #genererar tabell för att se vad som sker i picksoftthreshold
  cat("\npower | R2    | slope | mean_k\n")
  for (i in seq_along(powers)) {
    cat(sprintf("  %3d  | %.3f | %5.2f | %.1f\n",
                powers[i], r2_vals[i], sft$fitIndices[i, 3], sft$fitIndices[i, 5]))
  }
  
  png(file.path(wgcna_dir, "02_soft_threshold.png"))
  par(mfrow = c(1, 2))
  plot(powers, r2_vals, type = "b", xlab = "Power", ylab = "R²",
       main = paste(tissue_label, "scale independence"))
  abline(h = r2_threshold, col = "red", lty = 2)
  plot(powers, sft$fitIndices[, 5], type = "b", xlab = "Power", ylab = "Mean k",
       main = "Mean connectivity")
  dev.off()
  
  softPower <- sft$fitIndices[which(r2_vals >= r2_threshold)[1], 1]
  if (is.na(softPower)) softPower <- 12
  if (!is.null(soft_power_override)) softPower <- soft_power_override
  cat("Using soft power:", softPower, "\n")
  rm(sft, r2_vals); gc()
  
  # Network
  net <- blockwiseModules(
    expr_wgcna,
    power = softPower, 
    networkType = "signed", 
    TOMType = "signed",
    minModuleSize = min_module_size,
    mergeCutHeight = merge_cut_height,
    reassignThreshold = 1e-6,
    numericLabels = FALSE,
    maxBlockSize = 7600, 
    saveTOMs = TRUE,
    saveTOMFileBase = file.path(wgcna_dir, "TOM"),
    verbose = 1,
    deepSplit = 2)
  gc()
  
  moduleColors <- net$colors
  n_grey <- sum(moduleColors == "grey")
  cat("\nModule sizes:\n"); print(sort(table(moduleColors), decreasing = TRUE))
  cat("Assigned:", length(moduleColors) - n_grey, "| Grey:", n_grey, "\n\n")
  
  write.csv(data.frame(gene = names(moduleColors), module = moduleColors),
            file.path(wgcna_dir, "gene_module_assignments.csv"), row.names = FALSE)
  
  png(file.path(wgcna_dir, "03_dendrogram.png"))
  plotDendroAndColors(net$dendrograms[[1]], moduleColors[net$blockGenes[[1]]],
                      "Modules", dendroLabels = FALSE, hang = 0.03,
                      main = paste(tissue_label, "| power =", softPower))
  dev.off()
  
  # Eigengenes
  MEs <- orderMEs(moduleEigengenes(expr_wgcna, moduleColors)$eigengenes)
  gc()
  
  # Trait matrix
  datTraits <- data.frame(week = as.numeric(as.character(sample_info$week)),
                          row.names = rownames(sample_info))
  if ("PASI"      %in% colnames(sample_info)) datTraits$PASI      <- as.numeric(sample_info$PASI)
  if ("age"       %in% colnames(sample_info)) datTraits$age       <- as.numeric(sample_info$age)
  if ("sex"       %in% colnames(sample_info)) datTraits$sex       <- as.integer(sample_info$sex == "Female")
  if ("HLA_C0602" %in% colnames(sample_info)) datTraits$HLA_C0602 <- as.numeric(sample_info$HLA_C0602)
  if ("drug" %in% colnames(sample_info) && nlevels(factor(sample_info$drug)) > 1) {
    dm <- model.matrix(~ drug - 1, data = sample_info)
    colnames(dm) <- gsub("drug", "", colnames(dm))
    datTraits <- cbind(datTraits, dm)
  }
  
  # KARTA
  moduleTraitCor  <- cor(MEs, datTraits, use = "p")
  moduleTraitPval <- corPvalueStudent(moduleTraitCor, nrow(expr_wgcna))
  textMatrix      <- paste0(signif(moduleTraitCor, 2), "\n(", signif(moduleTraitPval, 1), ")")
  dim(textMatrix) <- dim(moduleTraitCor)
  
  png(file.path(wgcna_dir, "04_module_trait_heatmap.png"), width = 1200,
      height =1000, res = 150)
      

  par(mar = c(8, 10, 3, 3))
  labeledHeatmap(Matrix = moduleTraitCor,
                 xLabels = colnames(datTraits), yLabels = names(MEs),
                 ySymbols = names(MEs), colorLabels = FALSE,
                 colors = blueWhiteRed(50), textMatrix = NULL,
                 setStdMargins = FALSE, cex.lab.y = 0.6, cex.lab.x = 0.7,
                 zlim = c(-1, 1),
                 main = paste("Module-trait —", tissue_label))
  dev.off()
  gc()
  
  # Eigengene trajectories
  traj_df <- MEs %>%
    as.data.frame() %>%
    mutate(week = sample_info$week) %>%
    pivot_longer(-week, names_to = "module", values_to = "eigengene") %>%
    filter(module != "MEgrey")
  
  ggsave(file.path(wgcna_dir, "05_eigengene_trajectories.png"),
         ggplot(traj_df, aes(x = week, y = eigengene, fill = week)) +
           geom_boxplot(outlier.shape = NA, alpha = 0.7) +
           geom_jitter(width = 0.15, size = 0.7, alpha = 0.5) +
           facet_wrap(~ module, scales = "free_y") +
           scale_fill_brewer(palette = "Dark2") +
           labs(title = tissue_label, x = "Week", y = "Eigengene") +
           theme_bw(base_size = 10) +
           theme(panel.grid = element_blank(), strip.text = element_text(face = "bold")),
         width = 14, height = 10, dpi = 300)
  rm(traj_df); gc()
  
  # Save
  saveRDS(list(soft_power = softPower, min_module_size = min_module_size,
               merge_cut_height = merge_cut_height,
               n_modules = length(unique(moduleColors)) - 1,
               pct_grey  = round(100 * n_grey / length(moduleColors), 1)),
          file.path(wgcna_dir, "params_used.rds"))
  saveRDS(MEs,         file.path(wgcna_dir, "module_eigengenes.rds"))
  saveRDS(moduleColors,file.path(wgcna_dir, "module_colors.rds"))
  saveRDS(datTraits,   file.path(wgcna_dir, "trait_matrix.rds"))
  saveRDS(sample_info, file.path(wgcna_dir, "sample_info.rds"))
  write.csv(as.data.frame(moduleTraitCor) %>% mutate(module = rownames(.)),
            file.path(wgcna_dir, "module_trait_correlations.csv"), row.names = TRUE)
  rm(net); gc()
  
  cat(tissue_label, "done.\n")
  return(list(MEs = MEs, moduleColors = moduleColors,
              datTraits = datTraits, sample_info = sample_info))
}

#  KÖÖÖR ======================================================================
cat("Loading lesional\n")
expr_tmp        <- readRDS(file.path(output_dir, "expr_wgcna_lesional.rds"))
sample_info_tmp <- readRDS(file.path(output_dir, "sample_info_lesional.rds"))
results_lesional <- run_wgcna(expr_tmp, sample_info_tmp, "Lesional Skin",
                              file.path(output_dir, "WGCNA_lesional"),
                              tissue_params$lesional$r2_threshold,
                              tissue_params$lesional$soft_power_override,
                              tissue_params$lesional$min_module_size,
                              tissue_params$lesional$merge_cut_height)
rm(expr_tmp, sample_info_tmp); gc()

cat("Loading nonlesional\n")
expr_tmp        <- readRDS(file.path(output_dir, "expr_wgcna_nonlesional.rds"))
sample_info_tmp <- readRDS(file.path(output_dir, "sample_info_nonlesional.rds"))
results_nonlesional <- run_wgcna(expr_tmp, sample_info_tmp, "Nonlesional Skin",
                                 file.path(output_dir, "WGCNA_nonlesional"),
                                 tissue_params$nonlesional$r2_threshold,
                                 tissue_params$nonlesional$soft_power_override,
                                 tissue_params$nonlesional$min_module_size,
                                 tissue_params$nonlesional$merge_cut_height)
rm(expr_tmp, sample_info_tmp); gc()

cat("Loading blood\n")
expr_tmp        <- readRDS(file.path(output_dir, "expr_wgcna_blood.rds"))
sample_info_tmp <- readRDS(file.path(output_dir, "sample_info_blood.rds"))
results_blood <- run_wgcna(expr_tmp, sample_info_tmp, "Blood",
